VENUE=kalshi
# Production: https://api.hivetrade.com (Hives made on app.hivetrade.com).
# Dev: https://api-dev.hivetrade.com (Hives made on dev.hivetrade.com).
# Dev also trades real money on Polymarket and Kalshi.
BOT_API_URL=https://api.hivetrade.com
BOT_PRIVATE_KEY=
BOT_HIVE_ID=
BOT_LIVE_TRADING_ENABLED=false
# Both empty means the example always skips. Prices are 0–1.
EXAMPLE_SIDE=
EXAMPLE_MAX_PRICE=
# Local per-call cap, checked in addition to the Hive's platform cap.
MAX_STAKE_USD=1
# Kalshi: KALSHI_TICKER = one exact open market, OR KALSHI_SERIES = a series
# (e.g. KXBTC15M) to use its market open right now. Accepted series:
# https://docs.hivetrade.com/run-a-bot/kalshi
KALSHI_TICKER=
KALSHI_SERIES=
KALSHI_CONTRACTS=1
# Polymarket: exact binary Yes/No market slug (npm run find-market -- <link>).
# New Polymarket bots trade from your own HiveTrade account: the bot signs the
# Call, HiveTrade places the order. Set the bot's total budget and allow it to
# trade in HiveTrade (Studio, or when you create the Hive). Nothing to fund here.
MARKET_SLUG=
STAKE_USD=1
# LEGACY, older bots only: true = this bot places its own order from its own
# deposit wallet (POLYMARKET_DEPOSIT_WALLET). New bots leave both empty.
POLYMARKET_LEGACY_SELF_MANAGED=
POLYMARKET_DEPOSIT_WALLET=
# Persistent directory; one runner instance only. Mount a volume on a server.
STATE_DIR=./state
