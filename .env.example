VENUE=kalshi
# Production: https://api.hivetrade.com (Hives made on app.hivetrade.com).
# Dev: https://api-dev.hivetrade.com (Hives made on dev.hivetrade.com).
# Dev also trades real money on Polymarket and Kalshi.
BOT_API_URL=https://api.hivetrade.com
BOT_PRIVATE_KEY=
BOT_HIVE_ID=
BOT_LIVE_TRADING_ENABLED=false
# Both empty means the example always skips. Prices are 0–1.
EXAMPLE_SIDE=
EXAMPLE_MAX_PRICE=
# Local per-call cap, checked in addition to the Hive's platform cap.
MAX_STAKE_USD=1
# Kalshi: exact currently open KXBTC15M / KXETH15M / KXSOL15M ticker.
KALSHI_TICKER=
KALSHI_CONTRACTS=1
# Polymarket: exact binary Yes/No market slug (npm run find-market -- <link>).
# POLYMARKET_DEPOSIT_WALLET is for older bots only; new Polymarket bots will
# trade from your own HiveTrade account (not self-serve yet). Leave it empty.
MARKET_SLUG=
POLYMARKET_DEPOSIT_WALLET=
STAKE_USD=1
# Persistent directory; one runner instance only. Mount a volume on a server.
STATE_DIR=./state
