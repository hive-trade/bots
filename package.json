{
  "name": "hivetrade-bot-examples",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "check": "node --check bot.mjs && node --check lib/protocol.mjs && node --check lib/polymarket.mjs && node --check lib/config.mjs && node --check lib/run.mjs",
    "test": "node --test",
    "start": "node --env-file=.env bot.mjs",
    "bind-wallet": "node --env-file=.env scripts/bind-wallet.mjs"
  },
  "dependencies": {
    "@polymarket/clob-client-v2": "1.0.3",
    "axios": "1.20.0",
    "viem": "2.55.5"
  },
  "overrides": {
    "ws": "8.21.0"
  }
}
