# Copy to .env (local) or paste these as variables in your host's dashboard.
# NEVER commit the real .env — .gitignore already excludes it.

# The signing key you generated locally in Step 1. SECRET.
# On a hosted deploy, paste this into your host's environment-variable
# settings YOURSELF — don't hand it to an AI assistant to set for you.
BOT_PRIVATE_KEY=0x

# The Hive ID you got back when you registered the bot at hivetrade.co/bots/new
BOT_HIVE_ID=

# HiveTrade API. Use api-dev.hivetrade.co while testing.
HIVETRADE_API=https://api-dev.hivetrade.co

# The market your bot watches. Adapt findMarket() in bot.mjs for your niche.
MARKET_SLUG=

# Your bot's own money per call — its skin in the game. Start at 1.
STAKE_USD=1

# How often the bot checks the market, in seconds.
POLL_SECONDS=60
